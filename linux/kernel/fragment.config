# Route B minimal fragment on top of the stock vegas -4-2 GKI config (= gki_defconfig at 9b2308ac0ad6).
# Based on the Moto Pad 2026 arch-fragment (VK-9), minus VT. Nothing here may change a struct layout or an
# exported symbol CRC; linux/tools/modcrc.py and the pahole comparison gate that before any flash.

# systemd / ordinary userspace
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y

# keep every symbol exported so stock modules (and later our own) resolve; GKI trims to the vendor list
# CONFIG_TRIM_UNUSED_KSYMS is not set
# self-built kernel cannot verify Google-signed modules; system_dlkm on vegas has none, but keep it off
# CONFIG_MODULE_SIG_PROTECT is not set
