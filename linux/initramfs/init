#!/bin/busybox sh
# vegas route-B probe /init (replaces Android's /init via init_boot_a).
# Goal: USB shell on the Mac, then ALWAYS end in lk fastboot. It never reboots to the system, so a bad
# boot cannot burn slot-A retries in a loop. Touch /stay from the shell to cancel the timed exit.
#   NCM: phone 172.16.42.1, Mac gets 172.16.42.2 by DHCP; `telnet 172.16.42.1`
#   ACM: /dev/cu.usbmodem* on the Mac (serial shell, fallback if NCM does not come up)
B=/bin/busybox
$B mkdir -p /proc /sys /dev /tmp /config /run /sbin /usr/bin /usr/sbin
$B --install -s
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
if grep -q devtmpfs /proc/filesystems; then
  mount -t devtmpfs devtmpfs /dev
  DEVMODE=devtmpfs
else
  mount -t tmpfs -o mode=0755 tmpfs /dev
  echo /sbin/mdev > /proc/sys/kernel/hotplug
  mdev -s
  DEVMODE=mdev   # stock GKI: no DEVTMPFS and no UEVENT_HELPER, so nodes for later devices need another `mdev -s`
fi
# telnetd needs ptys (2026-11-22: without devpts, port 23 stayed closed)
mkdir -p /dev/pts
mount -t devpts -o mode=0620,ptmxmode=0666 devpts /dev/pts
[ -e /dev/ptmx ] || ln -s pts/ptmx /dev/ptmx
LOG=/tmp/init.log
# <3> = KERN_ERR, so the line passes the console loglevel and lands in pstore (console-ramoops) for the next boot
log() { echo "probe: $*" >> $LOG; echo "<3>probe: $*" > /dev/kmsg 2>/dev/null; }
bail() {
  log "FAIL: $* -> bootloader in 60s"
  [ -s /tmp/insmod.fail ] && while read -r l; do log "insmod failed: $l"; done < /tmp/insmod.fail
  sleep 60; /bin/rebootbl
}
TIMEOUT=600
( sleep $TIMEOUT; [ -e /stay ] || { log "timeout -> bootloader"; /bin/rebootbl; } ) &
log "start, /dev via $DEVMODE, kernel $(uname -r)"

# Vendor ramdisk modules, in Android's first-stage order (same concatenated rootfs). modules.load is NOT dependency
# ordered (mtk-spmi-pmic is line 49, its dep regmap-spmi line 98), so load each module's modules.dep entries first,
# last dep first, as Android's libmodprobe does. 2026-11-22: plain insmod in list order left the PMIC unloaded ->
# no vusb33 regulator -> mtu3 deferred forever -> no UDC.
ok=0; fail=0; mkdir -p /tmp/ld
ldmod() {
  local m="$1" deps rev d
  [ -e "/tmp/ld/$m" ] && return 0
  touch "/tmp/ld/$m"
  [ -f "/lib/modules/$m" ] || { echo "$m (missing)" >> /tmp/insmod.fail; return 1; }
  deps=$(grep "^/lib/modules/$m:" /lib/modules/modules.dep | cut -d: -f2)
  rev=""; for d in $deps; do rev="${d##*/} $rev"; done
  for d in $rev; do ldmod "$d"; done
  if insmod "/lib/modules/$m" 2>>/tmp/insmod.err; then ok=$((ok+1)); else fail=$((fail+1)); echo "$m" >> /tmp/insmod.fail; fi
}
while read -r m; do ldmod "${m##*/}"; done < /lib/modules/modules.load
for m in reboot-mode.ko syscon-reboot-mode.ko; do ldmod "$m"; done
log "modules: $ok loaded, $fail failed ($(wc -l < /proc/modules) live)"
[ "$DEVMODE" = mdev ] && mdev -s

# USB device mode: wait for a UDC (mtu3), force role=device if a role switch exists
for i in $(seq 1 30); do [ -n "$(ls /sys/class/udc 2>/dev/null)" ] && break; sleep 1; done
UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
[ -n "$UDC" ] || bail "no UDC"
for r in /sys/class/usb_role/*/role; do [ -w "$r" ] && echo device > "$r"; done
mount -t configfs none /config
G=/config/usb_gadget/g1
mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409
echo 0x1d6b > $G/idVendor; echo 0x0104 > $G/idProduct
echo 0xEF > $G/bDeviceClass; echo 0x02 > $G/bDeviceSubClass; echo 0x01 > $G/bDeviceProtocol
SER=$(sed -n 's/.*androidboot.serialno=\([^ ]*\).*/\1/p' /proc/cmdline)
[ -n "$SER" ] || SER=$(grep -ao 'androidboot.serialno = "[^"]*"' /proc/bootconfig 2>/dev/null | cut -d'"' -f2)
echo "${SER:-vegas}" > $G/strings/0x409/serialnumber
echo vegas-linux > $G/strings/0x409/manufacturer
echo "route-B probe" > $G/strings/0x409/product
echo "ncm+acm" > $G/configs/c.1/strings/0x409/configuration
mkdir -p $G/functions/ncm.usb0 $G/functions/acm.GS0
ln -s $G/functions/ncm.usb0 $G/configs/c.1/
ln -s $G/functions/acm.GS0 $G/configs/c.1/
echo "$UDC" > $G/UDC || bail "bind UDC $UDC"
log "gadget bound to $UDC"
sleep 1; mdev -s   # create /dev/ttyGS0 (no hotplug helper on the stock kernel)
log "ttyGS0: $([ -e /dev/ttyGS0 ] && echo present || echo MISSING)"

# Serial shell (respawning) and network shell
( while :; do [ -e /dev/ttyGS0 ] || mdev -s; [ -e /dev/ttyGS0 ] && setsid sh -c 'exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1'; sleep 1; done ) &
for i in $(seq 1 10); do ip link show usb0 >/dev/null 2>&1 && break; sleep 1; done
if ip link show usb0 >/dev/null 2>&1; then
  ip addr add 172.16.42.1/24 dev usb0; ip link set usb0 up
  printf 'start 172.16.42.2\nend 172.16.42.2\ninterface usb0\noption subnet 255.255.255.0\nlease_file /tmp/udhcpd.leases\n' > /tmp/udhcpd.conf
  touch /tmp/udhcpd.leases; udhcpd /tmp/udhcpd.conf
  telnetd -l /bin/sh
  sleep 1
  if netstat -ltn 2>/dev/null | grep -q ':23 '; then log "usb0 up 172.16.42.1, telnetd listening"
  else log "usb0 up 172.16.42.1, telnetd NOT listening"; fi
else
  log "no usb0 (NCM); ACM serial only"
fi
dmesg > /tmp/dmesg.boot
log "ready; exit to bootloader in ${TIMEOUT}s unless /stay exists"
while :; do sleep 3600; done
