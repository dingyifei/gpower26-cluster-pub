# vegas sway config (2026-11-23). Only the panel: mediatek_drm also exposes a phantom 4096x2160 "DP-1"
# (connector 92) whose CRTC goes dual-pipe and oopses the kernel. Never enable anything but DSI-1.
# Edits take effect at the NEXT BOOT only: never `swaymsg reload` (D10, a reload is a full modeset; the compositor
# must never exit). For a live try, send the same line as a runtime command (swaymsg '<line>').
xwayland disable
output * disable
# subpixel none: sway does not rotate the subpixel order with vegas-rotate (UI spec 5.8)
output DSI-1 enable mode 1080x2388@60Hz scale 3 position 0 0 subpixel none bg #1d3b53 solid_color
# insets (physical px): the bar is 36 logical = 108 px over the camera band; bottom 48, sides 30
default_border none
default_floating_border none
titlebar_padding 1
gaps inner 0
gaps outer 0
gaps left 10
gaps right 10
gaps bottom 16
focus_follows_mouse no
input type:touch map_to_output DSI-1
seat * hide_cursor 3000
# the top strip: /usr/lib/vegas/swaystatus runs vegas-status --bar (falls back to a plain line). Its fit around the camera
# hole assumes `font monospace 10` and `status_edge_padding 20` (VEGAS_STRIP_CHAR_PX / VEGAS_STRIP_PAD if changed).
bar {
    position top
    height 36
    font monospace 10
    workspace_buttons no
    tray_output none
    status_edge_padding 20
    # swaybar runs this through sh -c: choom puts the feed (Python) back at a normal OOM score (swaybar itself is
    # started by sway without a shell and keeps sway's -1000)
    status_command exec choom -n 0 -- /usr/lib/vegas/swaystatus
    colors {
        background #000000
        statusline #e0e0e0
    }
}
# glance / PIN pad window of vegas-keys (vegas-glance): over the strip and the terminal
for_window [app_id="vegas-glance"] floating enable, fullscreen enable, border none
# graphical programs go to workspace 2, tiled (D18); the terminal and the glance stay on 1. bemenu and wvkbd are
# layer-shell surfaces, not windows, so this rule does not touch them.
for_window [app_id="^(?!vegas-term$|vegas-glance$).*"] move container to workspace number 2, workspace number 2
# the terminal is pinned to 1: vegas-term reopens foot whenever it exits, and a new window would otherwise map on the
# focused workspace (next to a program on 2, which "Close program" = [workspace=2] kill would then close too)
for_window [app_id="^vegas-term$"] move container to workspace number 1, workspace number 1
# Hide key of keyboard v2 (wvkbd-vegas): it sends KEY_F20 (keycode 198), which wvkbd's keymap gives the keysym
# XF86AudioMicMute, so `bindsym F20` (spec 5.9) never matches. The keysym form is the one tested (VM, virtual keyboard).
# The modifier variants catch a tap while Ctrl/Alt/Shift is latched on the keyboard (sway matches modifiers exactly).
# vegas-kbd hide = the person's choice (also kept for shell windows; see vegasui/uictl.py)
bindsym XF86AudioMicMute exec /usr/lib/vegas/vegas-kbd hide
bindsym Ctrl+XF86AudioMicMute exec /usr/lib/vegas/vegas-kbd hide
bindsym Mod1+XF86AudioMicMute exec /usr/lib/vegas/vegas-kbd hide
bindsym Shift+XF86AudioMicMute exec /usr/lib/vegas/vegas-kbd hide
# choom -n 0: clients run at a normal OOM score (vegas-sway.service gives sway itself -1000, which children inherit).
# /run/vegas-ui (0700) is normally made by vegas-keys before sway starts; made here too so the clients never race it.
exec mkdir -p -m 700 /run/vegas-ui
# terminal: foot (JetBrains Mono 7.25, 60 columns) attached to tmux session "main", reopened when it exits
exec choom -n 0 -- /usr/lib/vegas/vegas-term
# keyboard: stock wvkbd-mobintl -H 250 --fn "Sans 10" (v1, the default; same height in landscape, where it finds its
# own landscape layer) in a restart loop that records /run/vegas-ui/kbd=shown; keyboard v2 (wvkbd-vegas) only when
# /etc/vegas/kbd-v2 exists (opt-in). Home and Network keep it down except for text fields (tmux hook, see vegas-kbd).
# wvkbd 0.15 default font (Sans 14) overflows the Esc/Cmp/Enter keys at -H 250; Sans 10 fits (#5, 2026-11-23)
exec choom -n 0 -- /usr/lib/vegas/vegas-kbd
# edge swipes (lisgd): bottom edge up = show keyboard, left/right edge in = previous/next tmux window
exec choom -n 0 -- /usr/lib/vegas/vegas-gestures
