#!/bin/sh
# swaybar status_command (sway config names this path): the top strip is vegas-status --bar (UI spec 1.4: i3bar
# JSON with taps; badges MAIN/RESCUE/AWAY/AP/kbd, links, SoC temperature, battery, minute clock).
# Fallback when vegas-status or its python package is missing or broken: the old plain-text line every 20 s, so the
# strip never goes blank (the node does not depend on any of this).
# (timeout: a probe that hangs must not leave the strip blank either)
# One-off camera-hole ruler: `vegas-status --ruler on|off` (a flag file the running feed reads; never a sway reload).
if timeout 15 /usr/local/bin/vegas-status --bar-once 360 >/dev/null 2>&1; then
  exec /usr/local/bin/vegas-status --bar
fi
# SoC zone as everywhere else (B3): the soc_max zone, thermal_zone0 only if there is none
zone=/sys/class/thermal/thermal_zone0
for z in /sys/class/thermal/thermal_zone*; do
  [ "$(cat "$z/type" 2>/dev/null)" = soc_max ] && { zone=$z; break; }
done
while :; do
  cap=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null)
  st=$(cat /sys/class/power_supply/battery/status 2>/dev/null)
  t=$(( $(cat "$zone/temp" 2>/dev/null || echo 0) / 1000 ))
  case $st in Charging) c="+" ;; "Not charging") c="=" ;; *) c="" ;; esac
  # swaybar right-aligns this plain line near the right edge (status_edge_padding does not apply to plain text:
  # it ends at x ~357); single spaces keep it within 17 characters (136.5 logical px, "23:59 105°C 100%+"), so it
  # starts right of x 220 (measured in the VM), clear of the camera hole's forbidden band x 166-194 (R6, see HOLE in
  # vegas-status; the old three-space line reached x 188 at 100 % and 105 °C)
  printf "%s %s°C %s%%%s\n" "$(date +%H:%M)" "$t" "$cap" "$c"
  sleep 20
done
