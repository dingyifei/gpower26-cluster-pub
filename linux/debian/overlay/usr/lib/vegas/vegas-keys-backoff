#!/bin/sh
# Restart backoff for vegas-keys.service (review 2026-11-23): Restart=always + RestartSec=1 + StartLimitIntervalSec=0
# never gives up, but a daemon that fails at start-up for good (half-installed python3-evdev, an import error, a thread
# that dies at once) would start Python once a second for as long as the phone runs. systemd's own RestartSteps= is not
# used: its counter never resets while the unit keeps auto-restarting (VM, systemd 257), so a few sporadic crashes over
# days would leave every later restart at the maximum delay with the power key dead meanwhile.
#   ExecStopPost=-/usr/lib/vegas/vegas-keys-backoff post   notes a failed run ($SERVICE_RESULT is not success)
#   ExecStartPre=-/usr/lib/vegas/vegas-keys-backoff pre    waits 0, 1, 3, 7, 15, 31, then 60 s per failed run that
#                                                          lasted < 30 s; a run of >= 30 s or a clean stop resets it
# State lives in /run (tmpfs): every boot starts with no wait, so sway (After vegas-keys) never waits at boot.
F=/run/vegas-keys.backoff
now=$(cut -d. -f1 /proc/uptime)
case ${1:-} in
  post)
    if [ "${SERVICE_RESULT:-success}" = success ]; then rm -f $F.fail; else echo "$now" > $F.fail; fi ;;
  pre)
    set -- $(cat $F 2>/dev/null) 0 0            # start time of the last run, failed fast runs in a row
    case $1$2 in *[!0-9]*) set -- 0 0 ;; esac
    if [ -e $F.fail ] && [ $((now - $1)) -lt 30 ]; then n=$(($2 + 1)); else n=0; fi
    rm -f $F.fail
    if [ $n -ge 6 ]; then d=60; else d=$(( (1 << n) - 1 )); fi
    if [ $d -gt 0 ]; then echo "vegas-keys: $n failed start(s) in a row, waiting $d s" >&2; sleep $d; fi
    echo "$(cut -d. -f1 /proc/uptime) $n" > $F ;;
  *) echo "usage: vegas-keys-backoff pre|post (ExecStartPre/ExecStopPost of vegas-keys.service)" >&2 ;;
esac
exit 0
